  - m_Id: 1961412211191808
    m_Localized: "\u041A\u043E\u0434 \u043A\u043E\u043C\u043D\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191810
    m_Localized: "\u041E\u0448\u0438\u0431\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191811
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435 \u043C\u0435\u043D\u044E.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191812
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u043B\u043E\u0431\u0431\u0438 \u0438\u043B\u0438 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0441\u0435\u0441\u0441\u0438\u044E. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191813
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191814
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191815
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191816
    m_Localized: "\u0412\u044B \u0442\u043E\u0447\u043D\u043E \u0445\u043E\u0442\u0438\u0442\u0435
      \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435
      \xAB{0}\xBB? \u042D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
      \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0442\u043C\u0435\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191817
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0443\u0434\u0430\u043B\u0438\u0442\u044C
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0435\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191818
    m_Localized: "\u0414\u043E\u0441\u0442\u0443\u043F \u043A \u043B\u043E\u0431\u0431\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191819
    m_Localized: "\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191820
    m_Localized: "\u0414\u043B\u044F \u0434\u0440\u0443\u0437\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 1961412211191821
